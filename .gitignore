# ==============================================================================
# Unity .gitignore
# ==============================================================================
/[Tt]opography_unity/[Ll]ibrary/
/[Tt]opography_unity/[Tt]emp/
/[Tt]opography_unity/[Oo]bj/
/[Tt]opography_unity/[Bb]uild/
/[Tt]opography_unity/[Bb]uilds/
/[Tt]opography_unity/[Ll]ogs/
/[Tt]opography_unity/[Uu]ser[Ss]ettings/
/[Tt]opography_unity/[Mm]emoryCaptures/
/[Tt]opography_unity/[Aa]ssets/AssetStoreTools*

# Unity autogenerated project / solution files
/[Tt]opography_unity/*.csproj
/[Tt]opography_unity/*.unityproj
/[Tt]opography_unity/*.sln
/[Tt]opography_unity/*.suo
/[Tt]opography_unity/*.user
/[Tt]opography_unity/*.userprefs
/[Tt]opography_unity/*.pidb
/[Tt]opography_unity/*.booproj
/[Tt]opography_unity/*.svd
/[Tt]opography_unity/*.pdb
/[Tt]opography_unity/*.opendb
/[Tt]opography_unity/*.VC.db

# General Unity rules
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
UnityLockfile
sysinfo.txt
*.pid
*.stackdump

# ==============================================================================
# Python & Machine Learning .gitignore
# ==============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Large Model Checkpoints (> 100MB GitHub limit)
# Note: Keep directory structures tracked via .gitkeep
*.pth
*.pt
*.ckpt
*.bin
*.onnx
*.safetensors
!**/.gitkeep

# Jupyter Notebooks & Tests
.ipynb_checkpoints
.pytest_cache/

# ==============================================================================
# IDE & System Files
# ==============================================================================
.vs/
.idea/
.vscode/
*.swp
*.swo
*~

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
